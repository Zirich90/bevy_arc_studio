// stdlib v1
import super::super::super::stdlib::curve::{sg_curve_hermite, sg_curve_linear};

// (t, value, slope) per point, sorted by t.
const POINTS: array<vec3<f32>, 5> = array<vec3<f32>, 5>(
    vec3<f32>(0.0, 0.2, 0.0),
    vec3<f32>(0.33, 0.2, 2.3529413),
    vec3<f32>(0.34, 1.0, 2.4242423),
    vec3<f32>(0.66, 1.0, -1.5151515),
    vec3<f32>(0.67, 0.5, -50.00005),
);

// Index of the segment [POINTS[i], POINTS[i + 1]] containing `x`.
fn segment(x: f32) -> u32 {
    var i = 0u;
    for (var k = 1u; k < 4u; k++) {
        if x >= POINTS[k].x {
            i = k;
        }
    }
    return i;
}

fn sample_curve_simple(t: f32) -> f32 {
    let x = clamp(t, POINTS[0].x, POINTS[4].x);
    let i = segment(x);
    return sg_curve_linear(POINTS[i], POINTS[i + 1u], x);
}

fn sample_curve_catmullrom(t: f32) -> f32 {
    let x = clamp(t, POINTS[0].x, POINTS[4].x);
    let i = segment(x);
    return sg_curve_hermite(POINTS[i], POINTS[i + 1u], x);
}
