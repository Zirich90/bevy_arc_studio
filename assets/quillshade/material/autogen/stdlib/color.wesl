// AUTOGENERATED by shader-editor v1 from stdlib::color — do not edit
// stdlib v1

// Color nodes (decision 0036). Every function without "srgb" in its name takes and returns linear RGB; the work is
// done in a perceptual space: OKLab / OKLCh for hue, chroma and lightness, sRGB-encoded values for HSV / HSL,
// contrast, gamma, levels, filters and blend modes. Hues are in turns (0..1).

const SG_TAU: f32 = 6.28318530718;

// -------------------------------------------------------------------------------------------------------------------
// sRGB transfer function (IEC 61966-2-1); negative components clamp to 0, values above 1 follow the curve.

fn sg_linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
    let x = max(c, vec3<f32>(0.0));
    let lo = x * 12.92;
    let hi = 1.055 * pow(x, vec3<f32>(1.0 / 2.4)) - 0.055;
    return select(hi, lo, x <= vec3<f32>(0.0031308));
}

fn sg_srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
    let x = max(c, vec3<f32>(0.0));
    let lo = x / 12.92;
    let hi = pow((x + 0.055) / 1.055, vec3<f32>(2.4));
    return select(hi, lo, x <= vec3<f32>(0.04045));
}

// -------------------------------------------------------------------------------------------------------------------
// HSV / HSL over sRGB-encoded values, like color pickers.

fn sg_srgb_to_hsv(c: vec3<f32>) -> vec3<f32> {
    let k = vec4<f32>(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    let p = select(vec4<f32>(c.bg, k.wz), vec4<f32>(c.gb, k.xy), c.g >= c.b);
    let q = select(vec4<f32>(p.xyw, c.r), vec4<f32>(c.r, p.yzx), c.r >= p.x);
    let d = q.x - min(q.w, q.y);
    let e = 1.0e-10;
    return vec3<f32>(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// Fully saturated color of hue `h` (sRGB-encoded).
fn sg_hue_srgb(h: f32) -> vec3<f32> {
    let p = abs(fract(vec3<f32>(h) + vec3<f32>(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - vec3<f32>(3.0));
    return saturate(p - vec3<f32>(1.0));
}

fn sg_rgb_to_hsv(c: vec3<f32>) -> vec3<f32> {
    return sg_srgb_to_hsv(sg_linear_to_srgb(c));
}

fn sg_hsv_to_rgb(hsv: vec3<f32>) -> vec3<f32> {
    return sg_srgb_to_linear(hsv.z * mix(vec3<f32>(1.0), sg_hue_srgb(hsv.x), hsv.y));
}

fn sg_rgb_to_hsl(c: vec3<f32>) -> vec3<f32> {
    let hsv = sg_rgb_to_hsv(c);
    let l = hsv.z * (1.0 - 0.5 * hsv.y);
    let s = (hsv.z - l) / max(min(l, 1.0 - l), 1.0e-10);
    return vec3<f32>(hsv.x, s, l);
}

fn sg_hsl_to_rgb(hsl: vec3<f32>) -> vec3<f32> {
    let chroma = hsl.y * (1.0 - abs(2.0 * hsl.z - 1.0));
    return sg_srgb_to_linear(vec3<f32>(hsl.z) + chroma * (sg_hue_srgb(hsl.x) - vec3<f32>(0.5)));
}

// -------------------------------------------------------------------------------------------------------------------
// OKLab (Björn Ottosson, 2020) over linear sRGB; OKLCh is its polar form.

fn sg_cbrt(x: vec3<f32>) -> vec3<f32> {
    return sign(x) * pow(abs(x), vec3<f32>(1.0 / 3.0));
}

fn sg_rgb_to_oklab(c: vec3<f32>) -> vec3<f32> {
    let lms = vec3<f32>(
        dot(c, vec3<f32>(0.4122214708, 0.5363325363, 0.0514459929)),
        dot(c, vec3<f32>(0.2119034982, 0.6806995451, 0.1073969566)),
        dot(c, vec3<f32>(0.0883024619, 0.2817188376, 0.6299787005)),
    );
    let t = sg_cbrt(lms);
    return vec3<f32>(
        dot(t, vec3<f32>(0.2104542553, 0.7936177850, -0.0040720468)),
        dot(t, vec3<f32>(1.9779984951, -2.4285922050, 0.4505937099)),
        dot(t, vec3<f32>(0.0259040371, 0.7827717662, -0.8086757660)),
    );
}

// Out-of-gamut results (negative components) clamp to 0.
fn sg_oklab_to_rgb(lab: vec3<f32>) -> vec3<f32> {
    let t = vec3<f32>(
        dot(lab, vec3<f32>(1.0, 0.3963377774, 0.2158037573)),
        dot(lab, vec3<f32>(1.0, -0.1055613458, -0.0638541728)),
        dot(lab, vec3<f32>(1.0, -0.0894841775, -1.2914855480)),
    );
    let lms = t * t * t;
    let rgb = vec3<f32>(
        dot(lms, vec3<f32>(4.0767416621, -3.3077115913, 0.2309699292)),
        dot(lms, vec3<f32>(-1.2684380046, 2.6097574011, -0.3413193965)),
        dot(lms, vec3<f32>(-0.0041960863, -0.7034186147, 1.7076147010)),
    );
    return max(rgb, vec3<f32>(0.0));
}

fn sg_rgb_to_oklch(c: vec3<f32>) -> vec3<f32> {
    let lab = sg_rgb_to_oklab(c);
    return vec3<f32>(lab.x, length(lab.yz), fract(atan2(lab.z, lab.y) / SG_TAU));
}

fn sg_oklch_to_rgb(lch: vec3<f32>) -> vec3<f32> {
    let a = lch.z * SG_TAU;
    return sg_oklab_to_rgb(vec3<f32>(lch.x, lch.y * cos(a), lch.y * sin(a)));
}

// -------------------------------------------------------------------------------------------------------------------
// OKLCh adjustments.

// Rotates the hue by `shift` turns, scales the chroma by `saturation`, then `L * scale + offset`.
fn sg_oklch_adjust(c: vec3<f32>, shift: f32, saturation: f32, scale: f32, offset: f32) -> vec3<f32> {
    let lab = sg_rgb_to_oklab(c);
    let a = shift * SG_TAU;
    let ca = cos(a);
    let sa = sin(a);
    let ab = vec2<f32>(lab.y * ca - lab.z * sa, lab.y * sa + lab.z * ca) * max(saturation, 0.0);
    return sg_oklab_to_rgb(vec3<f32>(max(lab.x * scale + offset, 0.0), ab));
}

fn sg_hue_shift(c: vec3<f32>, shift: f32) -> vec3<f32> {
    return sg_oklch_adjust(c, shift, 1.0, 1.0, 0.0);
}

fn sg_saturation(c: vec3<f32>, saturation: f32) -> vec3<f32> {
    return sg_oklch_adjust(c, 0.0, saturation, 1.0, 0.0);
}

fn sg_lightness(c: vec3<f32>, scale: f32, offset: f32) -> vec3<f32> {
    return sg_oklch_adjust(c, 0.0, 1.0, scale, offset);
}

fn sg_hue_saturation_lightness(c: vec3<f32>, shift: f32, saturation: f32, lightness: f32) -> vec3<f32> {
    return sg_oklch_adjust(c, shift, saturation, lightness, 0.0);
}

// Keeps the lightness, takes hue and chroma from `tint`, blended by `amount`.
fn sg_colorize(c: vec3<f32>, tint: vec3<f32>, amount: f32) -> vec3<f32> {
    let lab = sg_rgb_to_oklab(c);
    let toned = vec3<f32>(lab.x, sg_rgb_to_oklab(tint).yz);
    return sg_oklab_to_rgb(mix(lab, toned, amount));
}

// Gray of the same perceived lightness (OKLab L, chroma 0).
fn sg_grayscale(c: vec3<f32>) -> vec3<f32> {
    let l = max(sg_rgb_to_oklab(c).x, 0.0);
    return vec3<f32>(l * l * l);
}

// -------------------------------------------------------------------------------------------------------------------
// Tone and filters over sRGB-encoded values.

fn sg_contrast(c: vec3<f32>, amount: f32, pivot: f32) -> vec3<f32> {
    return sg_srgb_to_linear((sg_linear_to_srgb(c) - vec3<f32>(pivot)) * amount + vec3<f32>(pivot));
}

// `gamma` > 1 brightens the midtones, like the middle slider of Levels.
fn sg_gamma(c: vec3<f32>, gamma: f32) -> vec3<f32> {
    return sg_srgb_to_linear(pow(sg_linear_to_srgb(c), vec3<f32>(1.0 / max(gamma, 1.0e-4))));
}

fn sg_levels(c: vec3<f32>, in_black: f32, in_white: f32, gamma: f32, out_black: f32, out_white: f32) -> vec3<f32> {
    let range = max(in_white - in_black, 1.0e-4);
    let t = saturate((sg_linear_to_srgb(c) - vec3<f32>(in_black)) / range);
    let g = pow(t, vec3<f32>(1.0 / max(gamma, 1.0e-4)));
    return sg_srgb_to_linear(mix(vec3<f32>(out_black), vec3<f32>(out_white), g));
}

// `luminance` weights the sRGB-encoded channels.
fn sg_desaturation(c: vec3<f32>, fraction: f32, luminance: vec3<f32>) -> vec3<f32> {
    let s = sg_linear_to_srgb(c);
    return sg_srgb_to_linear(mix(s, vec3<f32>(dot(s, luminance)), fraction));
}

fn sg_sepia(c: vec3<f32>, amount: f32) -> vec3<f32> {
    let s = sg_linear_to_srgb(c);
    let tone = vec3<f32>(
        dot(s, vec3<f32>(0.393, 0.769, 0.189)),
        dot(s, vec3<f32>(0.349, 0.686, 0.168)),
        dot(s, vec3<f32>(0.272, 0.534, 0.131)),
    );
    return sg_srgb_to_linear(mix(s, tone, amount));
}

fn sg_invert(c: vec3<f32>) -> vec3<f32> {
    return sg_srgb_to_linear(vec3<f32>(1.0) - sg_linear_to_srgb(c));
}

// `steps` levels per channel (at least 2).
fn sg_posterize(c: vec3<f32>, steps: f32) -> vec3<f32> {
    let n = max(floor(steps), 2.0);
    let s = saturate(sg_linear_to_srgb(c));
    return sg_srgb_to_linear(min(floor(s * n), vec3<f32>(n - 1.0)) / (n - 1.0));
}

// -------------------------------------------------------------------------------------------------------------------
// Blend modes (Photoshop / W3C compositing formulas) over sRGB-encoded base `a` and blend `b`.

fn sg_blend_burn(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    let r = vec3<f32>(1.0) - min(vec3<f32>(1.0), (vec3<f32>(1.0) - a) / max(b, vec3<f32>(1.0e-5)));
    return select(select(r, vec3<f32>(0.0), b <= vec3<f32>(0.0)), vec3<f32>(1.0), a >= vec3<f32>(1.0));
}

fn sg_blend_darken(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return min(a, b);
}

fn sg_blend_difference(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return abs(a - b);
}

fn sg_blend_dodge(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    let r = min(vec3<f32>(1.0), a / max(vec3<f32>(1.0) - b, vec3<f32>(1.0e-5)));
    return select(select(r, vec3<f32>(1.0), b >= vec3<f32>(1.0)), vec3<f32>(0.0), a <= vec3<f32>(0.0));
}

fn sg_blend_hard_light(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return sg_blend_overlay(b, a);
}

fn sg_blend_lighten(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return max(a, b);
}

fn sg_blend_multiply(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return a * b;
}

fn sg_blend_overlay(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    let lo = 2.0 * a * b;
    let hi = vec3<f32>(1.0) - 2.0 * (vec3<f32>(1.0) - a) * (vec3<f32>(1.0) - b);
    return select(hi, lo, a < vec3<f32>(0.5));
}

fn sg_blend_screen(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(1.0) - (vec3<f32>(1.0) - a) * (vec3<f32>(1.0) - b);
}

// W3C soft light.
fn sg_blend_soft_light(a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    let x = max(a, vec3<f32>(0.0));
    let d = select(sqrt(x), ((16.0 * x - 12.0) * x + 4.0) * x, x <= vec3<f32>(0.25));
    let lo = x - (vec3<f32>(1.0) - 2.0 * b) * x * (vec3<f32>(1.0) - x);
    let hi = x + (2.0 * b - vec3<f32>(1.0)) * (d - x);
    return select(hi, lo, b <= vec3<f32>(0.5));
}

// -------------------------------------------------------------------------------------------------------------------
// Generators.

// Approximate black body color for a temperature in Kelvin (linear RGB, 0..1).
fn sg_blackbody(temp: f32) -> vec3<f32> {
    let t = clamp(temp, 1000.0, 40000.0) / 100.0;
    var r: f32 = 1.0;
    var g: f32;
    var b: f32 = 1.0;
    if (t <= 66.0) {
        g = 0.3900815787 * log(t) - 0.6318414437;
    } else {
        r = 1.2929361860 * pow(t - 60.0, -0.1332047592);
        g = 1.1298908608 * pow(t - 60.0, -0.0755148492);
    }
    if (t <= 19.0) {
        b = 0.0;
    } else if (t < 66.0) {
        b = 0.5432067891 * log(t - 10.0) - 1.1962540891;
    }
    return pow(saturate(vec3<f32>(r, g, b)), vec3<f32>(2.2));
}
