// stdlib v1

// PBR material attributes: one value carrying a whole layer (decision 0023). Field order and defaults match
// `shader_graph_core::attributes::pbr_fields`; World Position Offset is not a field.
struct MaterialAttributesPbr {
    base_color: vec3<f32>,
    metallic: f32,
    specular: f32,
    roughness: f32,
    emissive: vec3<f32>,
    opacity: f32,
    opacity_mask: f32,
    normal: vec3<f32>,
    ambient_occlusion: f32,
}

// Per-field `mix`; the tangent-space normal is not renormalized here (the material output does that).
fn sg_lerp_attributes_pbr(a: MaterialAttributesPbr, b: MaterialAttributesPbr, t: f32) -> MaterialAttributesPbr {
    return MaterialAttributesPbr(
        mix(a.base_color, b.base_color, t),
        mix(a.metallic, b.metallic, t),
        mix(a.specular, b.specular, t),
        mix(a.roughness, b.roughness, t),
        mix(a.emissive, b.emissive, t),
        mix(a.opacity, b.opacity, t),
        mix(a.opacity_mask, b.opacity_mask, t),
        mix(a.normal, b.normal, t),
        mix(a.ambient_occlusion, b.ambient_occlusion, t),
    );
}
