// AUTOGENERATED by shader-editor v1 from stdlib::pattern — do not edit
// stdlib v1

// Pattern masks (decision 0040): checkerboard, anti-aliased grid and the blockout grid built from both. The
// triplanar variants project world position onto the three axis planes and blend them by the normal.

import super::color::sg_lightness;

// Weights of the three axis planes (YZ, XZ, XY) for normal `n`, summing to 1.
fn sg_triplanar_weights(n: vec3<f32>) -> vec3<f32> {
    let a = abs(n);
    return a / max(a.x + a.y + a.z, 1e-5);
}

// Checkerboard of `size` squares: 0 or 1.
fn sg_checker(uv: vec2<f32>, size: f32) -> f32 {
    let c = floor(uv / size);
    return abs(c.x + c.y) % 2.0;
}

// Triplanar checkerboard of `size` cubes in world units.
fn sg_checker3(p: vec3<f32>, n: vec3<f32>, size: f32) -> f32 {
    let w = sg_triplanar_weights(n);
    return sg_checker(p.zy, size) * w.x + sg_checker(p.xz, size) * w.y + sg_checker(p.xy, size) * w.z;
}

// Anti-aliased grid of unit cells, 1 on the lines: "The Best Darn Grid Shader (Yet)" by Ben Golus
// (https://bgolus.medium.com/the-best-darn-grid-shader-yet-727f9278b9d8). `line_width` per axis in cell units;
// above 0.5 the grid is drawn inverted. Uses derivatives, so fragment stage only.
fn sg_pristine_grid(uv: vec2<f32>, line_width: vec2<f32>) -> f32 {
    let dx = dpdx(uv);
    let dy = dpdy(uv);
    let deriv = vec2<f32>(length(vec2<f32>(dx.x, dy.x)), length(vec2<f32>(dx.y, dy.y)));
    let invert = line_width > vec2<f32>(0.5);
    let target_width = select(line_width, 1.0 - line_width, invert);
    let draw_width = clamp(target_width, deriv, vec2<f32>(0.5));
    let aa = deriv * 1.5;
    let g = abs(fract(uv) * 2.0 - 1.0);
    var grid = smoothstep(draw_width + aa, draw_width - aa, select(1.0 - g, g, invert));
    grid *= saturate(target_width / draw_width);
    grid = mix(grid, target_width, saturate(deriv * 2.0 - 1.0));
    grid = select(grid, 1.0 - grid, invert);
    return mix(grid.x, 1.0, grid.y);
}

// Triplanar grid of `cell` cubes in world units, 1 on the lines.
fn sg_grid3(p: vec3<f32>, n: vec3<f32>, cell: f32, line_width: vec2<f32>) -> f32 {
    let w = sg_triplanar_weights(n);
    let q = p / cell;
    return sg_pristine_grid(q.zy, line_width) * w.x + sg_pristine_grid(q.xz, line_width) * w.y
        + sg_pristine_grid(q.xy, line_width) * w.z;
}

// Level-design blockout: `floor_color` on surfaces facing straight up or down, `wall_color` elsewhere, darkened in
// OKLab by a checkerboard of `cell` and `cell / 10` cubes, with grid lines of `line_color` every `cell`.
fn sg_blockout_grid(
    p: vec3<f32>,
    n: vec3<f32>,
    cell: f32,
    line_width: vec2<f32>,
    floor_color: vec3<f32>,
    wall_color: vec3<f32>,
    line_color: vec3<f32>,
) -> vec3<f32> {
    // 0.1 or 1 per checkerboard, averaged: the lightness drops by at most 0.18.
    let k = (sg_checker3(p, n, cell * 0.1) + sg_checker3(p, n, cell)) * 0.5;
    let base = select(wall_color, floor_color, abs(n.y) >= 0.99);
    let shaded = sg_lightness(base, 1.0, (0.1 + 0.9 * k) * 0.2 - 0.2);
    return mix(shaded, line_color, sg_grid3(p, n, cell, line_width));
}
