// AUTOGENERATED by shader-editor v1 from stdlib::scene — do not edit
// stdlib v1

// Scene textures of the view (Scene category): the camera's depth prepass. A view texture is bound only when the camera
// has its prepass component (`DepthPrepass`), and never in the prepass pipeline itself, so every read has a fallback:
// no depth prepass reads as nothing in front of the far plane.
import bevy_pbr::render::mesh_view_bindings::view;
import bevy_pbr::render::view_transformations::depth_ndc_to_view_z;

// Linear depth returned where the depth prepass has nothing (cleared to the far plane) or is not bound.
const SG_SCENE_FAR: f32 = 1.0e30;

// Framebuffer pixel position of viewport UV `uv` (0..1 inside the camera's viewport, as `@builtin(position).xy`).
fn sg_scene_pixel(uv: vec2<f32>) -> vec2<f32> {
    return view.viewport.xy + uv * view.viewport.zw;
}

// Raw (reverse-Z NDC) depth of the depth prepass at framebuffer pixel `pixel`; 0.0 (the far plane) without it. A load,
// not a filtered sample: depth textures cannot be filtered, and with MSAA they are multisampled (sample 0 is read).
fn sg_scene_depth_raw(pixel: vec2<f32>) -> f32 {
    var depth = 0.0;
    @if(DEPTH_PREPASS && !PREPASS_PIPELINE) {
        let size = vec2<i32>(textureDimensions(bevy_pbr::render::mesh_view_bindings::depth_prepass_texture));
        let p = clamp(vec2<i32>(floor(pixel)), vec2<i32>(0), size - vec2<i32>(1));
        depth = textureLoad(bevy_pbr::render::mesh_view_bindings::depth_prepass_texture, p, 0);
    }
    return depth;
}

// Linear view-space depth of raw depth `raw` (distance along the view direction, like PixelDepth); `SG_SCENE_FAR` at
// the far plane.
fn sg_linear_depth(raw: f32) -> f32 {
    if raw <= 0.0 {
        return SG_SCENE_FAR;
    }
    return -depth_ndc_to_view_z(raw);
}

// Linear depth of the depth prepass at framebuffer pixel `pixel`.
fn sg_scene_depth(pixel: vec2<f32>) -> f32 {
    return sg_linear_depth(sg_scene_depth_raw(pixel));
}

// UE's DepthFade: 0 where the fragment `frag_coord` touches the scene behind it, 1 at `distance` in front of it.
fn sg_depth_fade(frag_coord: vec4<f32>, distance: f32) -> f32 {
    let gap = sg_scene_depth(frag_coord.xy) - sg_linear_depth(frag_coord.z);
    return saturate(gap / max(distance, 1.0e-4));
}
