// AUTOGENERATED by shader-editor v1 from stdlib::texture — do not edit
// stdlib v1

// Unpacks a normal map sample from 0..1 to -1..1 (alpha untouched).
fn sg_unpack_normal(s: vec4<f32>) -> vec4<f32> {
    return vec4<f32>(s.rgb * 2.0 - 1.0, s.a);
}

// Tangent-space normal from the red channel of a height texture.
fn sg_normal_from_height(t: texture_2d<f32>, s: sampler, uv: vec2<f32>, scale: f32) -> vec3<f32> {
    let texel = vec2<f32>(1.0) / vec2<f32>(textureDimensions(t));
    let h = textureSample(t, s, uv).r;
    let hx = textureSample(t, s, uv + vec2<f32>(texel.x, 0.0)).r;
    let hy = textureSample(t, s, uv + vec2<f32>(0.0, texel.y)).r;
    return normalize(vec3<f32>((h - hx) * scale, (h - hy) * scale, 1.0));
}

// Row `v` of a baked gradient collection (gradient design §7) at `t`: `t` maps to texel centres (127/128, 0.5/128),
// so 0 and 1 hit the first / last texel. Level 0 explicitly: no mipmaps, and it works in the vertex stage too.
fn sg_sample_gradient(tex: texture_2d<f32>, samp: sampler, t: f32, v: f32) -> vec4<f32> {
    return textureSampleLevel(tex, samp, vec2<f32>(saturate(t) * 0.9921875 + 0.00390625, v), 0.0);
}
