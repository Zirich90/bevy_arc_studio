// stdlib v1

// Upper 3x3 of a 4x4 matrix.
fn sg_mat3(m: mat4x4<f32>) -> mat3x3<f32> {
    return mat3x3<f32>(m[0].xyz, m[1].xyz, m[2].xyz);
}

// Tangent → world basis from a world normal and a mikktspace tangent (w = handedness).
fn sg_tbn(n: vec3<f32>, t: vec4<f32>) -> mat3x3<f32> {
    let nn = normalize(n);
    let tt = normalize(t.xyz - nn * dot(nn, t.xyz));
    let b = cross(nn, tt) * select(1.0, -1.0, t.w < 0.0);
    return mat3x3<f32>(tt, b, nn);
}

// Inverse of the upper 3x3 of `m` (world → local for directions).
fn sg_inverse_rotation(m: mat4x4<f32>) -> mat3x3<f32> {
    let a = sg_mat3(m);
    let c0 = cross(a[1], a[2]);
    let c1 = cross(a[2], a[0]);
    let c2 = cross(a[0], a[1]);
    return transpose(mat3x3<f32>(c0, c1, c2)) * (1.0 / dot(a[0], c0));
}
