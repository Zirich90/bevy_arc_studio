// AUTOGENERATED by shader-editor v1 from stdlib::uv — do not edit
// stdlib v1

// Rotates `uv` around `center` by `angle` radians.
fn sg_rotate_uv(uv: vec2<f32>, center: vec2<f32>, angle: f32) -> vec2<f32> {
    let s = sin(angle);
    let c = cos(angle);
    let p = uv - center;
    return vec2<f32>(p.x * c - p.y * s, p.x * s + p.y * c) + center;
}

// UV of one atlas cell: frames go left to right, top to bottom; `phase` in 0..1.
fn sg_flipbook_uv(uv: vec2<f32>, rows: f32, cols: f32, phase: f32) -> vec2<f32> {
    let r = max(rows, 1.0);
    let c = max(cols, 1.0);
    let frame = floor(fract(phase) * r * c);
    let col = frame - c * floor(frame / c);
    let row = floor(frame / c);
    return (fract(uv) + vec2<f32>(col, row)) / vec2<f32>(c, r);
}
